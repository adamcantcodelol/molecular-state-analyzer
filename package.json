{
  "name": "molecular-state-analyzer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "verify:hmm": "node scripts/run-verify.mjs verify-hmm",
    "verify:aic": "node scripts/run-verify.mjs verify-aic",
    "verify:bootstrap": "node scripts/run-verify.mjs verify-bootstrap",
    "verify:synthetic": "node scripts/run-verify.mjs verify-synthetic",
    "verify:notebook": "node scripts/run-verify.mjs verify-notebook",
    "verify:security": "node scripts/run-verify.mjs verify-security",
    "verify:qa": "npm run verify:hmm && npm run verify:aic && npm run verify:bootstrap && npm run verify:synthetic && npm run verify:notebook && npm run verify:security"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "molstar": "^5.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "sass": "^1.104.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
